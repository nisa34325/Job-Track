{
  "name": "jobtrack",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Smart job application tracker with a React UI and SQLite storage.",
  "engines": {
    "node": ">=22.5.0"
  },
  "scripts": {
    "postinstall": "npm install --prefix client",
    "dev": "concurrently -n server,client -c green,blue \"npm run dev:server\" \"npm run dev:client\"",
    "dev:server": "node --disable-warning=ExperimentalWarning --watch server/index.js",
    "dev:client": "npm run dev --prefix client",
    "start": "node --disable-warning=ExperimentalWarning server/index.js",
    "build": "npm run build --prefix client"
  },
  "dependencies": {
    "express": "^4.21.2"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}
